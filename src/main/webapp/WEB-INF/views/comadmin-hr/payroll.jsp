<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="<%= com.hrms.i18n.Language.selected(request) %>">
<head>
<%@ include file="/WEB-INF/views/common/language.jspf" %>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-token" content="<c:out value='${payrollCsrf}'/>">
    <title><%= com.hrms.i18n.Language.text(request, "ui_78f95e303c84", "Quản lý lương · HRMs Cloud") %></title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/payroll.css?v=20261026-payslips-1">
<%@ include file="/WEB-INF/views/common/workspace-theme.jspf" %>
</head>
<body class="lc workspace-payroll" data-page="${salaryPage ? 'salaries' : 'payroll'}" data-context="${pageContext.request.contextPath}">
<div class="pay-shell">
    <%@ include file="/WEB-INF/views/common/tenant-shell.jspf" %>
    <main class="lc-main pay-main">

        <div class="pay-content">
            <div class="page-heading"><div><div class="eyebrow">PAYROLL MANAGEMENT</div><h1><c:set var="i18nConditionalLabel" value="${salaryPage ? 'Thiết lập lương cơ bản' : 'Quản lý kỳ lương'}"/><c:out value='<%= com.hrms.i18n.Language.message(request, pageContext.findAttribute("i18nConditionalLabel")) %>'/></h1><p><c:set var="i18nConditionalLabel" value="${salaryPage ? 'Thiết lập mức lương cho từng nhân viên, làm cơ sở cho các kỳ tính lương.' : 'Từ dữ liệu lương đến phiếu lương — mọi bước trong cùng một không gian.'}"/><c:out value='<%= com.hrms.i18n.Language.message(request, pageContext.findAttribute("i18nConditionalLabel")) %>'/></p></div><c:if test="${not salaryPage}"><button class="btn primary" id="newPeriod"><%= com.hrms.i18n.Language.text(request, "ui_efeac4fb7566", "＋ Tạo kỳ lương") %></button></c:if></div>
            <div id="feedback" class="feedback" role="status" aria-live="polite" hidden></div>
            <c:choose><c:when test="${salaryPage}">
                <div class="info-note"><%= com.hrms.i18n.Language.text(request, "ui_65457966627b", "Mức lương và phụ cấp đang có hiệu lực hôm nay. Cập nhật theo ngày hiệu lực; không cho sửa nguồn lương của kỳ đã duyệt/công bố. Các kỳ chưa duyệt bị ảnh hưởng sẽ cần tính lại.") %></div>
                <section class="pay-card"><div class="card-toolbar"><h2><%= com.hrms.i18n.Language.text(request, "ui_ef489d24a6a3", "Danh sách mức lương") %></h2><label class="search-field"><span>⌕</span><input id="salarySearch" type="search" placeholder="<%= com.hrms.i18n.Language.text(request, "ui_a43bbd25194e", "Tìm tên, mã nhân viên hoặc phòng ban") %>" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_be33b65f40bc", "Tìm nhân viên") %>"></label></div><div class="table-scroll"><table><thead><tr><th><%= com.hrms.i18n.Language.text(request, "ui_14ddd70d2564", "Nhân viên") %></th><th><%= com.hrms.i18n.Language.text(request, "ui_6f358f848e2e", "Phòng ban") %></th><th><%= com.hrms.i18n.Language.text(request, "ui_e03c1401e314", "Trạng thái") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_832b5c6af3ff", "Lương cơ bản (VND)") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_ac5d493eaa5e", "Phụ cấp trách nhiệm") %></th><th><%= com.hrms.i18n.Language.text(request, "ui_fed024b82c0a", "Thao tác") %></th></tr></thead><tbody id="salaryRows"><tr><td colspan="6" class="empty"><%= com.hrms.i18n.Language.text(request, "ui_e6b584854879", "Đang tải dữ liệu…") %></td></tr></tbody></table></div><div class="pagination" id="salaryPagination"></div></section>
            </c:when><c:otherwise>
                <section class="workflow-strip" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_b1b59e711b5a", "Quy trình tính lương") %>"><div><span>01</span><strong><%= com.hrms.i18n.Language.text(request, "ui_021c6e1c4d74", "Chuẩn bị") %></strong><small><%= com.hrms.i18n.Language.text(request, "ui_e7351d02e30c", "Lương & điều chỉnh") %></small></div><i>→</i><div><span>02</span><strong><%= com.hrms.i18n.Language.text(request, "ui_937bcc18133e", "Tính lương") %></strong><small><%= com.hrms.i18n.Language.text(request, "ui_aa88baac3881", "Kết quả tự động") %></small></div><i>→</i><div><span>03</span><strong><%= com.hrms.i18n.Language.text(request, "ui_ec0a446ca1fc", "Rà soát & duyệt") %></strong><small><%= com.hrms.i18n.Language.text(request, "ui_8e29bdbfc767", "Xác nhận bảng lương") %></small></div><i>→</i><div><span>04</span><strong><%= com.hrms.i18n.Language.text(request, "ui_3bec228bfe1a", "Công bố") %></strong><small><%= com.hrms.i18n.Language.text(request, "ui_f169d1a87a72", "Phiếu lương & thông báo") %></small></div></section>
                <section class="pay-card periods-card"><div class="card-toolbar"><h2><%= com.hrms.i18n.Language.text(request, "ui_1f22d2859e01", "Kỳ lương") %> <span id="periodCount" class="count" aria-live="polite">0</span></h2><div class="toolbar-fields"><select id="yearFilter" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_a89c934bbacb", "Lọc năm") %>"><option value=""><%= com.hrms.i18n.Language.text(request, "ui_b97f711f0b89", "Tất cả năm") %></option></select><select id="statusFilter" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_fa369313d3b4", "Lọc trạng thái") %>"><option value=""><%= com.hrms.i18n.Language.text(request, "ui_872e04b463ff", "Tất cả trạng thái") %></option><option>Draft</option><option>Calculated</option><option>Reviewed</option><option>Approved</option></select><button class="btn secondary" id="refreshPeriods" type="button"><%= com.hrms.i18n.Language.text(request, "ui_9452d72a84cf", "↻ Tải lại") %></button></div></div><div id="periodList" class="period-list" role="group" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_5e96d41d7641", "Danh sách kỳ lương") %>" aria-busy="true"><div class="empty"><%= com.hrms.i18n.Language.text(request, "ui_64f660fad581", "Đang tải kỳ lương…") %></div></div></section>
                <div id="periodDetailState" class="info-note" role="status" aria-live="polite" hidden></div>
                <section id="periodWorkspace" hidden>
                    <div class="period-heading"><div><div class="eyebrow"><%= com.hrms.i18n.Language.text(request, "ui_e8e259c18dc0", "KỲ LƯƠNG ĐANG CHỌN") %></div><h2 id="periodTitle"></h2><div id="periodBadges" class="badge-row"></div></div><div id="periodActions" class="action-row"></div></div>
                    <div id="periodNotice" class="info-note"></div>
                    <div id="periodReviewHistory" class="info-note" hidden></div>
                    <section class="pay-card adjustments-card" aria-labelledby="adjustmentsTitle">
                        <div class="card-toolbar"><div><h2 id="adjustmentsTitle"><%= com.hrms.i18n.Language.text(request, "ui_e17998ce285e", "Điều chỉnh thưởng / khấu trừ") %></h2><p class="subtle"><%= com.hrms.i18n.Language.text(request, "ui_2ad543557cc4", "Danh sách nhân viên trong công ty. Chọn Điều chỉnh để thêm hoặc sửa thưởng, khấu trừ và ghi chú.") %></p></div><span id="adjustmentLock" class="badge closed" hidden><%= com.hrms.i18n.Language.text(request, "ui_bcc435973804", "Chỉ xem · Kỳ đã khóa") %></span></div>
                        <div class="table-filter"><label class="search-field"><span>⌕</span><input id="adjustmentSearch" type="search" placeholder="<%= com.hrms.i18n.Language.text(request, "ui_c80238f61d7b", "Tìm tên hoặc mã nhân viên") %>" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_db845fbaf56b", "Tìm nhân viên để điều chỉnh") %>"></label><span id="adjustmentCount" class="subtle"></span></div>
                        <div class="table-scroll"><table><thead><tr><th><%= com.hrms.i18n.Language.text(request, "ui_84979604c762", "Mã nhân viên") %></th><th><%= com.hrms.i18n.Language.text(request, "ui_3da3c8c2738b", "Họ tên") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_f6195db41766", "Lương cơ bản") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_1dff4c8c3481", "Thưởng") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_fb27a98c7cba", "Khấu trừ") %></th><th><%= com.hrms.i18n.Language.text(request, "ui_02f03f68e75d", "Ghi chú") %></th><th><%= com.hrms.i18n.Language.text(request, "ui_fed024b82c0a", "Thao tác") %></th></tr></thead><tbody id="adjustmentRows"></tbody></table></div>
                        <div class="pagination" id="adjustmentPagination"></div>
                        <p class="adjustment-help subtle"><%= com.hrms.i18n.Language.text(request, "ui_bbcc23100aa1", "Nhân viên chưa có hợp đồng hoặc mức lương hợp lệ vẫn có thể lưu điều chỉnh. Kết quả tính lương chỉ bao gồm nhân viên đủ điều kiện trong kỳ.") %></p>
                    </section>
                    <section class="pay-metrics"><div class="metric"><small><%= com.hrms.i18n.Language.text(request, "ui_d798a23f9959", "Nhân viên trong kỳ") %></small><strong id="metricEmployees">—</strong><span><%= com.hrms.i18n.Language.text(request, "ui_1c5cd70dab50", "Hồ sơ thuộc công ty") %></span></div><div class="metric"><small><%= com.hrms.i18n.Language.text(request, "ui_835bbc822b95", "Tổng thu nhập") %></small><strong id="metricIncome">—</strong><span><%= com.hrms.i18n.Language.text(request, "ui_49b9b0092cb4", "Lương + Phụ cấp + Thưởng · VND") %></span></div><div class="metric"><small><%= com.hrms.i18n.Language.text(request, "ui_1a1d64400cd7", "Tổng khấu trừ") %></small><strong id="metricDeduction">—</strong><span>VND</span></div><div class="metric highlight"><small><%= com.hrms.i18n.Language.text(request, "ui_4e66b7d05033", "Tổng thực nhận") %></small><strong id="metricNet">—</strong><span id="metricNetNote"><%= com.hrms.i18n.Language.text(request, "ui_3a80f5c6f33c", "Chưa tính lương") %></span></div></section>
                    <section class="pay-card"><div class="card-toolbar"><div><h2><%= com.hrms.i18n.Language.text(request, "ui_8a8ce94e2e7c", "Bảng lương nhân viên") %></h2><p class="subtle"><%= com.hrms.i18n.Language.text(request, "ui_3a33eeb5f1d0", "Lương cơ bản + Phụ cấp trách nhiệm + Thưởng − Khấu trừ = Thực nhận") %></p></div><div class="toolbar-fields"><button class="btn secondary" id="templateButton"><%= com.hrms.i18n.Language.text(request, "ui_50bacaa8f160", "↓ File mẫu Excel") %></button><button class="btn secondary" id="importButton"><%= com.hrms.i18n.Language.text(request, "ui_d5f91186d645", "↑ Nhập Excel") %></button></div></div><div class="table-filter"><label class="search-field"><span>⌕</span><input type="search" id="rowSearch" placeholder="<%= com.hrms.i18n.Language.text(request, "ui_c80238f61d7b", "Tìm tên hoặc mã nhân viên") %>" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_608ea43940cf", "Tìm nhân viên trong kỳ") %>"></label><span id="rowCount" class="subtle"></span></div><div class="table-scroll"><table><thead><tr><th><%= com.hrms.i18n.Language.text(request, "ui_84979604c762", "Mã nhân viên") %></th><th><%= com.hrms.i18n.Language.text(request, "ui_3da3c8c2738b", "Họ tên") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_f6195db41766", "Lương cơ bản") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_ac5d493eaa5e", "Phụ cấp trách nhiệm") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_1dff4c8c3481", "Thưởng") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_fb27a98c7cba", "Khấu trừ") %></th><th class="number"><%= com.hrms.i18n.Language.text(request, "ui_bda3b5abe5e4", "Thực nhận") %></th><th><%= com.hrms.i18n.Language.text(request, "ui_fed024b82c0a", "Thao tác") %></th></tr></thead><tbody id="payrollRows"></tbody></table></div><div class="pagination" id="rowPagination"></div></section>
                </section>
            </c:otherwise></c:choose>
            <footer class="pay-footer">HRMs Cloud <span>•</span> <%= com.hrms.i18n.Language.text(request, "ui_72fe236bc647", "Quản lý lương trong không gian công ty của bạn") %></footer>
        </div>
    </main>
</div>
<dialog id="createDialog" class="pay-dialog"><form id="createForm"><div class="dialog-heading"><div><div class="eyebrow"><%= com.hrms.i18n.Language.text(request, "ui_436b6784623d", "KỲ TÍNH LƯƠNG MỚI") %></div><h2><%= com.hrms.i18n.Language.text(request, "ui_fab76f892682", "Tạo kỳ lương") %></h2></div><button type="button" class="icon-button" data-dismiss aria-label="<%= com.hrms.i18n.Language.text(request, "ui_d2b73ab2ada1", "Đóng") %>">×</button></div><p class="subtle"><%= com.hrms.i18n.Language.text(request, "ui_e3f8da69a504", "Mỗi tháng chỉ có một kỳ lương trong công ty. Kỳ mới bắt đầu ở Draft.") %></p><label><%= com.hrms.i18n.Language.text(request, "ui_3b8d69c9f892", "Tên kỳ lương") %><input name="periodName" maxlength="100" placeholder="<%= com.hrms.i18n.Language.text(request, "ui_5c8b0d0e47cc", "Tự đặt theo tháng và năm nếu để trống") %>"></label><div class="form-pair"><label><%= com.hrms.i18n.Language.text(request, "ui_0e2b309955fe", "Tháng") %><select name="month" required><c:forEach begin="1" end="12" var="month"><option value="${month}"><%= com.hrms.i18n.Language.text(request, "ui_0e2b309955fe", "Tháng") %> ${month}</option></c:forEach></select></label><label><%= com.hrms.i18n.Language.text(request, "ui_98926c7e765d", "Năm") %><input name="year" type="number" min="2000" max="9999" required></label></div><div class="dialog-error" role="alert" hidden></div><div class="dialog-actions"><button type="button" class="btn secondary" data-dismiss><%= com.hrms.i18n.Language.text(request, "ui_34ca764caf22", "Hủy") %></button><button class="btn primary" type="submit"><%= com.hrms.i18n.Language.text(request, "ui_fab76f892682", "Tạo kỳ lương") %></button></div></form></dialog>
<dialog id="salaryDialog" class="pay-dialog"><form id="salaryForm">
    <div class="dialog-heading"><h2><%= com.hrms.i18n.Language.text(request, "ui_9b3a291b86eb", "Cập nhật lương cơ bản") %></h2><button type="button" class="icon-button" data-dismiss aria-label="<%= com.hrms.i18n.Language.text(request, "ui_d2b73ab2ada1", "Đóng") %>">×</button></div>
    <p id="salaryEmployee" class="employee-label"></p><input name="employeeId" type="hidden">
    <div class="salary-amount-field">
        <label for="salaryAmount"><%= com.hrms.i18n.Language.text(request, "ui_832b5c6af3ff", "Lương cơ bản (VND)") %></label>
        <div class="salary-amount-control">
            <input id="salaryAmount" name="baseSalary" type="number" min="0" max="9999999999999999.99" step="0.01" data-salary-step="100000" required aria-describedby="salaryStepHint">
            <div class="salary-amount-buttons">
                <button type="button" data-salary-direction="1" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_bf83a0c13a43", "Tăng 100.000 đồng") %>" title="<%= com.hrms.i18n.Language.text(request, "ui_bf83a0c13a43", "Tăng 100.000 đồng") %>">▴</button>
                <button type="button" data-salary-direction="-1" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_64d0a77203b5", "Giảm 100.000 đồng") %>" title="<%= com.hrms.i18n.Language.text(request, "ui_64d0a77203b5", "Giảm 100.000 đồng") %>">▾</button>
            </div>
        </div>
        <small id="salaryStepHint" class="subtle"><%= com.hrms.i18n.Language.text(request, "ui_948fe1647d0e", "Mỗi lần bấm tăng/giảm 100.000đ. Bạn có thể gõ trực tiếp mức lương.") %></small>
    </div>
    <label><%= com.hrms.i18n.Language.text(request, "ui_651d62aeac55", "Ngày hiệu lực") %><input name="effectiveFrom" type="date" min="2000-01-01" max="9999-12-31" required></label>
    <p class="subtle"><%= com.hrms.i18n.Language.text(request, "ui_16c7f53c5f50", "Lưu thành lịch sử lương, giữ các mức lương trước ngày này và lịch lương đã hẹn sau đó. Thay đổi giữa tháng cần có quy tắc được xác nhận trước khi tính kỳ đó.") %></p>
    <div class="dialog-error" role="alert" hidden></div><div class="dialog-actions"><button class="btn secondary" type="button" data-dismiss><%= com.hrms.i18n.Language.text(request, "ui_34ca764caf22", "Hủy") %></button><button class="btn primary" type="submit"><%= com.hrms.i18n.Language.text(request, "ui_ca8b15656335", "Lưu mức lương") %></button></div>
</form></dialog>
<dialog id="calculationPreviewDialog" class="pay-dialog wide" aria-labelledby="calculationPreviewTitle"><div class="dialog-heading"><h2 id="calculationPreviewTitle"><%= com.hrms.i18n.Language.text(request, "ui_2d9d31d8c93c", "Xem trước bảng lương") %></h2><button type="button" class="icon-button" data-dismiss aria-label="<%= com.hrms.i18n.Language.text(request, "ui_d2b73ab2ada1", "Đóng") %>">×</button></div><div id="calculationPreviewContent" aria-live="polite"></div><div class="dialog-error" role="alert" hidden></div><div class="dialog-actions"><button type="button" class="btn secondary" data-dismiss><%= com.hrms.i18n.Language.text(request, "ui_79294ac84b35", "Đóng xem trước") %></button></div></dialog>
<dialog id="adjustmentDialog" class="pay-dialog" aria-labelledby="adjustmentTitle"><form id="adjustmentForm" novalidate>
    <div class="dialog-heading"><h2 id="adjustmentTitle"><%= com.hrms.i18n.Language.text(request, "ui_5aa8a11acb89", "Điều chỉnh lương") %></h2><button type="button" class="icon-button" data-dismiss aria-label="<%= com.hrms.i18n.Language.text(request, "ui_d2b73ab2ada1", "Đóng") %>">×</button></div>
    <p id="adjustmentEmployee" class="employee-label"></p><input name="employeeId" type="hidden">
    <div class="form-pair">
        <label><%= com.hrms.i18n.Language.text(request, "ui_a8c17a9c5995", "Thưởng / Bonus (VND)") %><input name="bonus" type="number" min="0" max="9999999999999999.99" step="0.01" required aria-describedby="bonusError"><small id="bonusError" class="adjustment-field-error" data-adjustment-error="bonus" role="alert" hidden></small></label>
        <label><%= com.hrms.i18n.Language.text(request, "ui_50896559af6f", "Khấu trừ / Deduction (VND)") %><input name="deduction" type="number" min="0" max="9999999999999999.99" step="0.01" required aria-describedby="deductionError"><small id="deductionError" class="adjustment-field-error" data-adjustment-error="deduction" role="alert" hidden></small></label>
    </div>
    <label><%= com.hrms.i18n.Language.text(request, "ui_02f03f68e75d", "Ghi chú") %><textarea name="note" maxlength="300" rows="3" placeholder="<%= com.hrms.i18n.Language.text(request, "ui_9b490133cc84", "Lý do thưởng hoặc khấu trừ") %>" aria-describedby="noteError"></textarea><small id="noteError" class="adjustment-field-error" data-adjustment-error="note" role="alert" hidden></small></label>
    <div class="info-note"><%= com.hrms.i18n.Language.text(request, "ui_eaf3ded7db16", "Thay đổi điều chỉnh đưa kỳ về Draft và xóa kết quả tính cũ để tính, rà soát và duyệt lại.") %></div>
    <p id="adjustmentSaveState" class="subtle" role="status" aria-live="polite"><%= com.hrms.i18n.Language.text(request, "ui_9a6788cf37de", "Chưa có thay đổi.") %></p>
    <div class="dialog-error" role="alert" hidden></div>
    <div class="dialog-actions"><button class="btn secondary" type="button" data-dismiss><%= com.hrms.i18n.Language.text(request, "ui_34ca764caf22", "Hủy") %></button><button class="btn primary" type="submit" disabled><%= com.hrms.i18n.Language.text(request, "ui_46419bee0b3f", "Lưu điều chỉnh") %></button></div>
</form></dialog>
