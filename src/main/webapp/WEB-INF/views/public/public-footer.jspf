<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="base" value="${pageContext.request.contextPath}"/>
<footer class="public-footer">
    <div class="public-container footer-grid">
        <div>
            <a class="brand-mark" href="${base}/homepage">
                <span class="logo-box">
                    HC
                </span>
                <span class="brand-copy">
                    <strong>
                        HRMs
                        <span>
                            Cloud
                        </span>
                    </strong>
                    <small>
                        <%= com.hrms.i18n.Language.text(request, "ui_8f5b18cac271", "DOANH NGHIỆP THÔNG MINH") %>
                    </small>
                </span>
            </a>
            <p>
                <%= com.hrms.i18n.Language.text(request, "ui_0eb02d24cfcb", "Hệ sinh thái số hóa hồ sơ, chấm công, tính lương và tự phục vụ nhân viên cho doanh nghiệp tăng trưởng tại Việt Nam.") %>
            </p>
            <p class="footer-contact">
                <%= com.hrms.i18n.Language.text(request, "ui_ca2345e0eceb", "Hotline tư vấn:") %>
                <strong>
                    0904 885 833
                </strong>
                <br>
                Email: contact@hrmscloud.vn
            </p>
        </div>
        <div>
            <h2>
                <%= com.hrms.i18n.Language.text(request, "ui_f0d515f3edb3", "Giải pháp &amp; Sản phẩm") %>
            </h2>
            <a href="${base}/features-solutions">
                <%= com.hrms.i18n.Language.text(request, "ui_c9c55114a63c", "Hồ sơ nhân sự số") %>
            </a>
            <a href="${base}/features-solutions">
                <%= com.hrms.i18n.Language.text(request, "ui_9190b3c34e5e", "Chấm công &amp; ca kíp") %>
            </a>
            <a href="${base}/features-solutions">
                <%= com.hrms.i18n.Language.text(request, "ui_4c3a53ab8cb7", "Tính lương tự động") %>
            </a>
            <a href="${base}/features-solutions">
                <%= com.hrms.i18n.Language.text(request, "ui_eb99224ebeea", "Cổng ESS") %>
            </a>
        </div>
        <div>
            <h2>
                <%= com.hrms.i18n.Language.text(request, "ui_d008c8ced3e4", "Hỗ trợ &amp; Tài nguyên") %>
            </h2>
            <a href="${base}/faqs">
                <%= com.hrms.i18n.Language.text(request, "ui_05b2ca99f14c", "Trung tâm Hỏi đáp") %>
            </a>
            <a href="${base}/consultation-request">
                <%= com.hrms.i18n.Language.text(request, "ui_2baee0d32519", "Yêu cầu tư vấn") %>
            </a>
            <a href="${base}/login">
                <%= com.hrms.i18n.Language.text(request, "ui_bf21f0d969b8", "Cổng đăng nhập tenant") %>
            </a>
        </div>
        <div>
            <h2>
                <%= com.hrms.i18n.Language.text(request, "ui_f20016cd497a", "Pháp lý &amp; Bảo mật") %>
            </h2>
            <p>
                <%= com.hrms.i18n.Language.text(request, "ui_b04e4c030229", "Thiết kế theo hướng bảo vệ dữ liệu doanh nghiệp và phân tách quyền truy cập theo workspace.") %>
            </p>
            <a href="${base}/Pricing">
                <%= com.hrms.i18n.Language.text(request, "ui_33e1985e1b2e", "Bảng giá tham chiếu") %>
            </a>
        </div>
    </div>
    <div class="public-container footer-bottom">
        <%= com.hrms.i18n.Language.text(request, "ui_e32ae4839183", "© 2026 HRMs Cloud. Tất cả các quyền được bảo lưu.") %>
    </div>
</footer>
