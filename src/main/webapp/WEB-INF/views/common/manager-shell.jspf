<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<aside class="lc-sidebar">
    <a class="lc-brand" href="${pageContext.request.contextPath}/attendance/manager-attendance">
        <span class="lc-logo">H</span><span class="lc-brand-name">HRMs Cloud</span>
    </a>
    <nav aria-label="Điều hướng Quản lý">
        <section class="lc-nav-group" data-nav-group="attendance">
            <button type="button" class="lc-group-toggle" aria-controls="lc-manager-att-links" aria-expanded="true">QUẢN LÝ CHẤM CÔNG</button>
            <div class="lc-nav-links" id="lc-manager-att-links">
                <a class="${managerNavPage == 'team-attendance' ? 'active' : ''}" href="${pageContext.request.contextPath}/attendance/manager-attendance"><span class="lc-nav-icon" aria-hidden="true">✓</span><span>Điểm danh Nhân sự</span></a>
                <a class="${managerNavPage == 'attendance-list' ? 'active' : ''}" href="${pageContext.request.contextPath}/attendance/manager-attendance?view=list"><span class="lc-nav-icon" aria-hidden="true">▦</span><span>Bảng chấm công</span></a>
                <a class="${managerNavPage == 'personal-attendance' ? 'active' : ''}" href="${pageContext.request.contextPath}/attendance/manager-personal-attendance"><span class="lc-nav-icon" aria-hidden="true">◷</span><span>Chấm công Cá nhân</span></a>
                <a class="${managerNavPage == 'attendance-report' ? 'active' : ''}" href="${pageContext.request.contextPath}/attendance/attendance-report"><span class="lc-nav-icon" aria-hidden="true">▤</span><span>Báo cáo Chấm công</span></a>
            </div>
        </section>
        <section class="lc-nav-group" data-nav-group="leave">
            <button type="button" class="lc-group-toggle" aria-controls="lc-manager-leave-links" aria-expanded="true">NGHỈ PHÉP & LƯƠNG</button>
            <div class="lc-nav-links" id="lc-manager-leave-links">
                <a class="${managerNavPage == 'leave-pending' ? 'active' : ''}" href="${pageContext.request.contextPath}/leave/pending-approvals"><span class="lc-nav-icon" aria-hidden="true">▢</span><span>Duyệt đơn nghỉ phép</span></a>
                <a class="${managerNavPage == 'payroll' ? 'active' : ''}" href="${pageContext.request.contextPath}/payroll"><span class="lc-nav-icon" aria-hidden="true">◈</span><span>Quản lý lương</span></a>
            </div>
        </section>
        <section class="lc-nav-group" data-nav-group="personal">
            <button type="button" class="lc-group-toggle" aria-controls="lc-manager-personal-links" aria-expanded="true">CÁ NHÂN</button>
            <div class="lc-nav-links" id="lc-manager-personal-links">
                <a class="${managerNavPage == 'profile' ? 'active' : ''}" href="${pageContext.request.contextPath}/employee/my-profile?nav=manager"><span class="lc-nav-icon" aria-hidden="true">♙</span><span>Hồ sơ cá nhân</span></a>
                <a class="${managerNavPage == 'payslips' ? 'active' : ''}" href="${pageContext.request.contextPath}/payslips"><span class="lc-nav-icon" aria-hidden="true">▱</span><span>Phiếu lương của tôi</span></a>
            </div>
        </section>
    </nav>
    <a class="lc-signout" href="${pageContext.request.contextPath}/logout" aria-label="Đăng xuất"><span class="lc-nav-icon" aria-hidden="true">↪</span><span>Đăng xuất</span></a>
</aside>
<header class="lc-topbar">
    <span>Cổng quản lý <span class="lc-muted">/ <c:out value="${managerNavTitle}" default="Chấm công"/></span></span>
    <span class="lc-workspace" title="<c:out value='${sessionScope.tenantPrincipal.companyName}'/>">Workspace · <c:out value="${sessionScope.tenantPrincipal.workspaceCode}" default="—"/></span>
</header>
<%@ include file="/WEB-INF/views/common/appearance.jspf" %>

