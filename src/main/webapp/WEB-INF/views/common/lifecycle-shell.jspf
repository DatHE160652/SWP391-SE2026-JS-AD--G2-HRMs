<a href="${pageContext.request.contextPath}/department/department-list"><span class="lc-nav-icon" aria-hidden="true">▦</span><span><%= com.hrms.i18n.Language.text(request, "ui_6f358f848e2e", "Phòng ban") %></span></a>
<a href="${pageContext.request.contextPath}/position/position-list"><span class="lc-nav-icon" aria-hidden="true">▣</span><span><%= com.hrms.i18n.Language.text(request, "ui_285d666f18b5", "Chức danh") %></span></a>
