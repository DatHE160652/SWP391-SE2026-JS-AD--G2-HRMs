<c:if test="${not empty sessionScope.tenantPrincipal.employeeId}">
<section class="lc-nav-group" data-nav-group="hr-personal"><button type="button" class="lc-group-toggle" aria-controls="lc-hr-personal-links" aria-expanded="true"><%= com.hrms.i18n.Language.text(request, "ui_3874d4ffe564", "CÁ NHÂN") %></button><div class="lc-nav-links" id="lc-hr-personal-links"><a href="${pageContext.request.contextPath}/employee/my-profile"><span class="lc-nav-icon" aria-hidden="true">♙</span><span><%= com.hrms.i18n.Language.text(request, "ui_b70d1e2772e9", "Hồ sơ cá nhân") %></span></a>
<a href="${pageContext.request.contextPath}/employee/my-contracts"><span class="lc-nav-icon" aria-hidden="true">▤</span><span><%= com.hrms.i18n.Language.text(request, "ui_4939da54ffa3", "Hợp đồng của tôi") %></span></a>
<a href="${pageContext.request.contextPath}/payslips"><span class="lc-nav-icon" aria-hidden="true">▱</span><span><%= com.hrms.i18n.Language.text(request, "ui_2e59daf63e47", "Phiếu lương của tôi") %></span></a>
</div></section>
</c:if>
</nav><a class="lc-signout" href="${pageContext.request.contextPath}/logout" aria-label="<%= com.hrms.i18n.Language.text(request, "ui_d513aac0be87", "Đăng xuất") %>"><span class="lc-nav-icon" aria-hidden="true">↪</span><span><%= com.hrms.i18n.Language.text(request, "ui_d513aac0be87", "Đăng xuất") %></span></a></aside>
