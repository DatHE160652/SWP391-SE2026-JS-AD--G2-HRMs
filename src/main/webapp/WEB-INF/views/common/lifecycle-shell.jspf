<a href="${pageContext.request.contextPath}/attendance/company-attendance"><span class="lc-nav-icon" aria-hidden="true">◷</span><span><%= com.hrms.i18n.Language.text(request, "ui_fc355fff8378", "Chấm công") %></span></a>
