<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:choose>
    <c:when test="${sessionScope.tenantPrincipal.roleCode == 'COMPANY_ADMIN' or sessionScope.tenantPrincipal.roleCode == 'HR'}">
        <%@ include file="/WEB-INF/views/common/lifecycle-shell.jspf" %>
    </c:when>
    <c:when test="${sessionScope.tenantPrincipal.roleCode == 'MANAGER'}">
        <%@ include file="/WEB-INF/views/common/manager-shell.jspf" %>
    </c:when>
    <c:otherwise>
        <%@ include file="/WEB-INF/views/common/employee-shell.jspf" %>
    </c:otherwise>
</c:choose>
