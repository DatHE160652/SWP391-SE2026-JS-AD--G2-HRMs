<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>HRMs - HR Management Platform for SMEs</display-name>

    <!--
        Servlet mappings will be added here as controllers are implemented.
        This project intentionally uses web.xml mappings instead of @WebServlet.
    -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.hrms.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>TenantAuthorizationFilter</filter-name>
        <filter-class>com.hrms.filter.TenantAuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>TenantAuthorizationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <mime-mapping>
        <extension>html</extension>
        <mime-type>text/html;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript;charset=UTF-8</mime-type>
    </mime-mapping>

    <servlet>
        <servlet-name>PublicPortalController</servlet-name>
        <servlet-class>com.hrms.controller.publicportal.PublicPortalController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PublicPortalController</servlet-name>
        <url-pattern>/homepage</url-pattern>
        <url-pattern>/features-solutions</url-pattern>
        <url-pattern>/Pricing</url-pattern>
        <url-pattern>/faqs</url-pattern>
        <url-pattern>/consultation-request</url-pattern>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/change-password</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>SystemAdminAuthFilter</filter-name>
        <filter-class>com.hrms.filter.SystemAdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SystemAdminAuthFilter</filter-name>
        <url-pattern>/systemadmin/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>EmployeeServlet</servlet-name>
        <servlet-class>com.hrms.controller.EmployeeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeServlet</servlet-name>
        <url-pattern>/employees</url-pattern>
        <url-pattern>/employees/me</url-pattern>
        <url-pattern>/employees/me/history</url-pattern>
        <url-pattern>/employees/me/update-profile</url-pattern>
        <url-pattern>/employees/detail</url-pattern>
        <url-pattern>/employees/history</url-pattern>
        <url-pattern>/employees/create</url-pattern>
        <url-pattern>/employees/update</url-pattern>
        <url-pattern>/employees/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DocumentServlet</servlet-name>
        <servlet-class>com.hrms.controller.DocumentServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>11534336</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentServlet</servlet-name>
        <url-pattern>/documents/me</url-pattern>
        <url-pattern>/documents/me/upload</url-pattern>
        <url-pattern>/documents/me/download</url-pattern>
        <url-pattern>/documents/me/delete</url-pattern>
        <url-pattern>/documents</url-pattern>
        <url-pattern>/documents/upload</url-pattern>
        <url-pattern>/documents/download</url-pattern>
        <url-pattern>/documents/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TenantPageController</servlet-name>
        <servlet-class>com.hrms.controller.TenantPageController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TenantPageController</servlet-name>
        <url-pattern>/employee/my-profile</url-pattern>
        <url-pattern>/employee/my-profile.html</url-pattern>
        <url-pattern>/employee/employee-list</url-pattern>
        <url-pattern>/employee/employee-list.html</url-pattern>
        <url-pattern>/employee/employee-form</url-pattern>
        <url-pattern>/employee/employee-form.html</url-pattern>
        <url-pattern>/employee/employee-detail</url-pattern>
        <url-pattern>/employee/employee-detail.html</url-pattern>
        <url-pattern>/department/department-list</url-pattern>
        <url-pattern>/department/department-list.html</url-pattern>
        <url-pattern>/department/department-form</url-pattern>
        <url-pattern>/department/department-form.html</url-pattern>
        <url-pattern>/position/position-list</url-pattern>
        <url-pattern>/position/position-list.html</url-pattern>
        <url-pattern>/position/position-form</url-pattern>
        <url-pattern>/position/position-form.html</url-pattern>
        <url-pattern>/document/employee-document-list</url-pattern>
        <url-pattern>/document/employee-document-list.html</url-pattern>
        <url-pattern>/document/document-upload</url-pattern>
        <url-pattern>/document/document-upload.html</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DepartmentServlet</servlet-name>
        <servlet-class>com.hrms.controller.DepartmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DepartmentServlet</servlet-name>
        <url-pattern>/departments</url-pattern>
        <url-pattern>/departments/detail</url-pattern>
        <url-pattern>/departments/create</url-pattern>
        <url-pattern>/departments/update</url-pattern>
        <url-pattern>/departments/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PositionServlet</servlet-name>
        <servlet-class>com.hrms.controller.PositionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PositionServlet</servlet-name>
        <url-pattern>/positions</url-pattern>
        <url-pattern>/positions/detail</url-pattern>
        <url-pattern>/positions/create</url-pattern>
        <url-pattern>/positions/update</url-pattern>
        <url-pattern>/positions/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmployeeAssignmentServlet</servlet-name>
        <servlet-class>com.hrms.controller.EmployeeAssignmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeAssignmentServlet</servlet-name>
        <url-pattern>/employees/organization</url-pattern>
        <url-pattern>/employees/assign-department</url-pattern>
        <url-pattern>/employees/assign-position</url-pattern>
        <url-pattern>/employees/assign-manager</url-pattern>
        <url-pattern>/departments/members</url-pattern>
        <url-pattern>/departments/assign-members</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AttendanceController</servlet-name>
        <servlet-class>com.hrms.controller.hr.AttendanceController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceController</servlet-name>
        <url-pattern>/attendance/personal</url-pattern>
        <url-pattern>/attendance/team</url-pattern>
        <url-pattern>/attendance/manager-attendance</url-pattern>
        <url-pattern>/attendance/employee-attendance</url-pattern>
        <url-pattern>/attendance/company-attendance</url-pattern>
        <url-pattern>/attendance/manager-personal-attendance</url-pattern>
        <url-pattern>/attendance/attendance-report</url-pattern>
        <url-pattern>/attendance/manager-attendance.html</url-pattern>
        <url-pattern>/attendance/employee-attendance.html</url-pattern>
        <url-pattern>/attendance/company-attendance.html</url-pattern>
        <url-pattern>/attendance/manager-personal-attendance.html</url-pattern>
        <url-pattern>/attendance/attendance-report.html</url-pattern>
        <url-pattern>/attendance/all</url-pattern>
        <url-pattern>/attendance/check-in</url-pattern>
        <url-pattern>/attendance/check-out</url-pattern>
        <url-pattern>/attendance/batch-complete</url-pattern>
        <url-pattern>/attendance/company</url-pattern>
        <url-pattern>/attendance/report</url-pattern>
        <url-pattern>/attendance/export-report</url-pattern>
        <url-pattern>/attendance/meta</url-pattern>
        <!-- Compatibility / Legacy manager routes -->
        <url-pattern>/manager/team-attendance</url-pattern>
        <url-pattern>/manager/employee-attendance</url-pattern>
        <url-pattern>/manager/employee-attendance.html</url-pattern>
        <url-pattern>/manager/company-attendance.html</url-pattern>
        <url-pattern>/manager/attendance-report.html</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SystemAdminLoginController</servlet-name>
        <servlet-class>com.hrms.controller.auth.SystemAdminLoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SystemAdminLoginController</servlet-name>
        <url-pattern>/systemadmin/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SystemAdminLogoutController</servlet-name>
        <servlet-class>com.hrms.controller.auth.SystemAdminLogoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SystemAdminLogoutController</servlet-name>
        <url-pattern>/systemadmin/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegistrationRequestController</servlet-name>
        <servlet-class>com.hrms.controller.sysadmin.RegistrationRequestController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistrationRequestController</servlet-name>
        <url-pattern>/systemadmin/dashboard</url-pattern>
        <url-pattern>/systemadmin/registration-request</url-pattern>
        <url-pattern>/systemadmin/registration-request-details</url-pattern>
        <url-pattern>/systemadmin/registration-request/confirm</url-pattern>
        <url-pattern>/systemadmin/registration-request/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CompanyAdministrationController</servlet-name>
        <servlet-class>com.hrms.controller.sysadmin.CompanyAdministrationController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompanyAdministrationController</servlet-name>
        <url-pattern>/systemadmin/company</url-pattern>
        <url-pattern>/systemadmin/company-details</url-pattern>
        <url-pattern>/systemadmin/company/suspend</url-pattern>
        <url-pattern>/systemadmin/company/activate</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>
</web-app>
