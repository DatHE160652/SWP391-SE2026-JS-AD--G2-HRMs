        <filter-name>SystemAdminAuthFilter</filter-name>
        <filter-class>com.hrms.filter.SystemAdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SystemAdminAuthFilter</filter-name>
        <url-pattern>/systemadmin/*</url-pattern>
    </filter-mapping>

